# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá estas mismas variables en Settings > Environment Variables.
# NUNCA subas al repositorio un archivo con las claves reales.

# Dirección pública del sitio, sin barra al final (en Vercel: https://tu-dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo se usa en el servidor. No lleva NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Calendario público de Google de Bifröst
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=2621bf8a432143553116176bfdd69319ff6157c0c356ed51cd210ed11b74e6b2@group.calendar.google.com
