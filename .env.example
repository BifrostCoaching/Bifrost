# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel, cargá estas mismas variables en Settings > Environment Variables.
# NUNCA subas al repositorio un archivo con las claves reales.

# Dirección pública del sitio, sin barra al final (en Vercel: https://tu-dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: solo se usa en el servidor. No lleva NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Tus integraciones > Credenciales de producción)
# Access Token: secreto, solo en el servidor.
MP_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Webhooks > Configurar notificaciones)
MP_WEBHOOK_SECRET=

# Calendario público de Google de Bifröst
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=affb255c54ac8925894fc9817997f70ed3ead0a267c37a2d8c41b2c7ece7b2af@group.calendar.google.com
